# Copy this file to .env and fill in your own values.
# .env is gitignored and never ships. Only REPLICATE_API_TOKEN, FAL_KEY and
# IMAGE_PROVIDER are read by the skill.

# Which image provider /meta-ads-static-creator uses for the photographic plate:
# fal | replicate. Leave blank to auto-pick: one key → that provider;
# both keys or neither → replicate.
IMAGE_PROVIDER=

# Replicate API token (starts with r8_). Recommended. Create a dedicated token at
# https://replicate.com/account/api-tokens — billed to your Replicate account.
# Replicate tokens cannot be spend-capped. Use prepaid credit with auto-reload
# off as a hard cap, and disable the token when idle. Tokens are account-wide
# (no scopes); disable it there if it is ever exposed.
REPLICATE_API_TOKEN=

# fal.ai API key for image generation. Get yours at https://fal.ai/
# Billed to your fal account. Used automatically if it is the only key set.
# The skill shows a cost estimate before every paid call.
FAL_KEY=
